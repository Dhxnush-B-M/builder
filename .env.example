# --- Application ---
PORT="3000"
SERVER_PORT="3001"
APP_URL="http://localhost:3000"

# --- Database (Supabase PostgreSQL) ---
# Example: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# --- Supabase API Keys ---
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
# Server-only: use only in Supabase Edge Function secrets, never in the web app.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Authentication ---
AUTH_SECRET="testing-secret-key-for-local-development-12345"

# --- Google OAuth 2.0 (Google Cloud Credentials) ---
# Authorized Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Feature Flags ---
FLAG_DISABLE_EMAIL_AUTH="true"
FLAG_DISABLE_SIGNUPS="false"
FLAG_DISABLE_IMAGE_PROCESSING="false"
FLAG_DISABLE_API_RATE_LIMIT="false"
FLAG_SHOW_SPONSORS="false"
FLAG_ALLOW_UNSAFE_OAUTH_REDIRECT_URI="false"
FLAG_ALLOW_UNSAFE_AI_BASE_URL="false"

# --- Razorpay Live Payment Gateway ---
# Set these as encrypted Cloudflare Pages secrets. Do not expose the secret in VITE_ variables.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
